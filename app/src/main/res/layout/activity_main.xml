<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brutalBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="20dp">

        <!-- HEADER BADGE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ ALL-IN-ONE MEDIA EXTRACTOR ]"
            android:background="@drawable/brutal_badge_background"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp" />

        <!-- MAIN TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BRUTAL&#10;DOWNLOADER"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/brutalForeground"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="4dp" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="► TIKTOK  ► INSTAGRAM  ► YOUTUBE"
            android:textSize="12sp"
            android:textColor="@color/brutalAccent"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- INPUT BOX CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/brutal_card_background"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET MEDIA URL"
                android:textColor="@color/brutalAccentYellow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/urlEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:background="@drawable/brutal_edit_background"
                android:hint="Paste video / reel / post link..."
                android:textColor="@color/brutalForeground"
                android:textColorHint="@color/brutalHint"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:layout_marginBottom="12dp" />

            <!-- ACTION BUTTONS IN INPUT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pasteButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="📋 PASTE FROM CLIPBOARD"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/brutal_button_secondary"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="✕"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/brutal_button_secondary"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- PLATFORM SELECTOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/brutal_card_background"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOURCE PLATFORM"
                android:textColor="@color/brutalAccentYellow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/sourceSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/brutal_spinner_background" />
        </LinearLayout>

        <!-- RESOLUTION SELECTOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/brutal_card_background"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET RESOLUTION / QUALITY"
                android:textColor="@color/brutalAccentYellow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/resolutionSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/brutal_spinner_background" />
        </LinearLayout>

        <!-- WEBVIEW CONTAINER (PREVIEW / STREAM EXTRACTOR) -->
        <LinearLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/brutal_card_background"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="► MEDIA PLAYER SNIFFER"
                android:textColor="@color/brutalAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="6dp" />

            <WebView
                android:id="@+id/extractorWebView"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#000000" />
        </LinearLayout>

        <!-- MAIN DOWNLOAD BUTTON -->
        <Button
            android:id="@+id/downloadButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚡ DOWNLOAD MEDIA"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/brutal_button_background"
            android:fontFamily="monospace"
            android:elevation="6dp"
            android:layout_marginBottom="12dp" />

        <!-- AUDIO ONLY BUTTON -->
        <Button
            android:id="@+id/downloadAudioButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="♫ DOWNLOAD AUDIO (ORIGINAL)"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/brutal_button_secondary"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

        <!-- CONSOLE / STATUS TERMINAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/brutal_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SYS_CONSOLE // OUTPUT"
                    android:textColor="@color/brutalGreen"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/percentTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/brutalAccentYellow"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginBottom="12dp"
                android:progressTint="@color/brutalAccent"
                android:indeterminateTint="@color/brutalAccentYellow"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:text="> SYSTEM READY.\n> Waiting for URL input...\n> Saved files will go to Downloads/BrutalDownloader."
                android:textColor="@color/brutalForeground"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
